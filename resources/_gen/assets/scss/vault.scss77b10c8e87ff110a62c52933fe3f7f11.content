.vault-shell{width:100%}.vault-gate{display:flex;justify-content:center;align-items:center;min-height:60vh;padding:3rem 1.5rem}.vault-gate[hidden],.vault-body[hidden]{display:none}:root{--vault-accent:#89C8FE;--vault-accent-soft:rgba(137, 200, 254, 0.12);--vault-accent-glow:rgba(137, 200, 254, 0.3)}.vault-gate-inner{width:100%;max-width:360px;text-align:center;animation:vault-reveal .7s cubic-bezier(.16,1,.3,1)both}@keyframes vault-reveal{from{opacity:0;transform:translateY(30px)scale(.96);filter:blur(8px)}to{opacity:1;transform:translateY(0)scale(1);filter:blur(0)}}@media(prefers-reduced-motion:reduce){.vault-gate-inner{animation:none;opacity:1}}.vault-gate-icon{display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;margin:0 auto 1.25rem;border-radius:16px;background:var(--vault-accent-soft);color:var(--vault-accent);font-size:1.5rem;animation:vault-icon-float 3.5s ease-in-out infinite;box-shadow:0 0 0 1px rgba(137,200,254,.15),0 4px 20px var(--vault-accent-glow)}@keyframes vault-icon-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}@media(prefers-reduced-motion:reduce){.vault-gate-icon{animation:none}}.vault-gate-title{margin:0 0 .375rem;font-size:1.5rem;font-weight:600;color:var(--fg-color,#1a1a1a);letter-spacing:-.015em}.vault-gate-desc{margin:0 0 2rem;font-size:.9375rem;line-height:1.55;color:var(--alt-fg-color,#737373)}.vault-gate-form{display:flex;flex-direction:column;gap:1rem}.vault-gate-input-wrapper{display:flex;align-items:center;gap:.5rem}.vault-gate-input{flex:1;min-width:0;padding:1rem 1.125rem;font-size:1.0625rem;color:var(--fg-color,#1a1a1a);background:var(--bg-color,#fff);border:1.5px solid var(--darker-alt-bg-color,#d4d4d4);border-radius:10px;outline:none;transition:border-color .2s ease,box-shadow .2s ease,background .2s ease,transform .15s ease}.vault-gate-input:hover{border-color:#bdbdbd}.vault-gate-input:focus{border-color:var(--vault-accent);box-shadow:0 0 0 4px var(--vault-accent-soft),0 8px 30px rgba(137,200,254,.12);transform:translateY(-1px);background:#fff}.vault-gate-input::placeholder{color:var(--alt-fg-color,#a3a3a3);transition:opacity .2s ease,transform .2s ease}.vault-gate-input:focus::placeholder{opacity:.6;transform:translateX(4px)}.vault-gate-toggle,.vault-gate-submit{flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;width:2.5rem;height:2.5rem;border-radius:8px;transition:color .15s ease,background .15s ease,transform .15s ease,box-shadow .15s ease}.vault-gate-toggle{background:0 0;border:none;color:var(--alt-fg-color,#a3a3a3);cursor:pointer}.vault-gate-toggle i{font-size:.9375rem}.vault-gate-toggle .fa-eye{display:block}.vault-gate-toggle .fa-eye-slash{display:none}.vault-gate-toggle:hover{color:var(--vault-accent);background:var(--vault-accent-soft);transform:scale(1.05)}.vault-gate-toggle:active{transform:scale(.95)}.vault-gate-toggle[aria-pressed=true] .fa-eye{display:none}.vault-gate-toggle[aria-pressed=true] .fa-eye-slash{display:block}.vault-gate-submit{position:relative;overflow:hidden;background:var(--vault-accent);border:none;color:#fff;cursor:pointer;box-shadow:0 2px 8px rgba(137,200,254,.25),0 0 0 1px rgba(137,200,254,.15)}.vault-gate-submit::before{content:"";position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,255,255,.25) 0%,transparent 50%);opacity:0;transition:opacity .2s ease}.vault-gate-submit i{font-size:1rem;transition:transform .2s ease}.vault-gate-submit:hover{background:#6db8fd;transform:translateY(-1px);box-shadow:0 4px 16px rgba(137,200,254,.35),0 0 0 1px rgba(137,200,254,.2)}.vault-gate-submit:hover::before{opacity:1}.vault-gate-submit:hover i{transform:translateX(2px)}.vault-gate-submit:active{transform:translateY(0)scale(.96);box-shadow:0 1px 4px rgba(137,200,254,.25),0 0 0 1px rgba(137,200,254,.15)}.vault-gate-submit:focus-visible{outline:none;box-shadow:0 0 0 4px var(--vault-accent-soft),0 4px 16px rgba(137,200,254,.35)}.vault-gate-remember{display:flex;align-items:center;justify-content:center;gap:.5rem;margin-top:.75rem;font-size:.8125rem;color:var(--alt-fg-color,#737373);cursor:pointer}.vault-gate-remember input{width:1rem;height:1rem;accent-color:var(--vault-accent);cursor:pointer;transition:transform .15s ease}.vault-gate-remember input:hover{transform:scale(1.1)}.vault-gate-error{margin:.5rem 0 0;font-size:.8125rem;color:var(--error-color,#dc2626);text-align:center;animation:vault-shake .4s ease;opacity:0;transform:translateY(-4px);pointer-events:none}.vault-gate-error:not([hidden]){opacity:1;transform:translateY(0);pointer-events:auto}@keyframes vault-shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-6px)}40%{transform:translateX(6px)}60%{transform:translateX(-4px)}80%{transform:translateX(4px)}}@media(prefers-reduced-motion:reduce){.vault-gate-error:not([hidden]){animation:none}}.vault-body{animation:vault-fade-in .3s ease}.vault-toolbar{display:flex;justify-content:flex-end;max-width:76rem;margin:0 auto 2rem;padding:0 1.5rem}.vault-lock-btn{display:inline-flex;align-items:center;gap:.5rem;padding:.5rem 1rem;font-size:.8125rem;color:var(--alt-fg-color,#737373);background:0 0;border:1px solid var(--darker-alt-bg-color,#d4d4d4);border-radius:8px;cursor:pointer;transition:color .15s ease,border-color .15s ease,background .15s ease,transform .1s ease}.vault-lock-btn:hover{color:var(--vault-accent);border-color:var(--vault-accent);background:var(--vault-accent-soft);transform:translateY(-1px)}.vault-lock-btn:active{transform:translateY(0)}.vault-lock-btn:focus-visible{outline:none;box-shadow:0 0 0 3px var(--vault-accent-soft)}.vault-intro{margin-top:1.5rem;font-size:.9375rem;line-height:1.7;color:var(--alt-fg-color,#737373)}.vault-empty{margin-top:2rem;font-size:.9375rem;color:var(--alt-fg-color,#737373);text-align:center}.vault-list .title-link i{margin-right:.4rem;color:var(--vault-accent)}.vault-update-dot{display:inline-block;width:.5rem;height:.5rem;margin-left:.5rem;vertical-align:super;background:var(--vault-accent);border-radius:50%;box-shadow:0 0 8px var(--vault-accent-glow);animation:vault-dot-breathe 2.4s ease-in-out infinite}.vault-update-dot[hidden]{display:none}@keyframes vault-dot-breathe{0%,100%{opacity:.5;transform:scale(.9);box-shadow:0 0 4px var(--vault-accent-glow)}50%{opacity:1;transform:scale(1);box-shadow:0 0 12px var(--vault-accent-glow)}}@media(prefers-reduced-motion:reduce){.vault-update-dot:not([hidden]){animation:none}}.vault-jump-btn{display:inline-flex;align-items:center;gap:.4rem;margin:0 0 1.5rem;padding:.5rem 1rem;font-size:.8125rem;font-weight:500;color:#fff;background:var(--vault-accent);border:none;border-radius:8px;cursor:pointer;transition:background .15s ease,transform .1s ease,box-shadow .15s ease;box-shadow:0 2px 8px rgba(137,200,254,.25)}.vault-jump-btn:hover{background:#6db8fd;transform:translateY(-1px);box-shadow:0 4px 16px rgba(137,200,254,.35)}.vault-jump-btn:active{transform:translateY(0)scale(.98)}.vault-jump-btn::before{content:"\2193"}.vault-diff-block{margin:1rem 0;padding:.5rem 1rem;border-radius:.375rem}.vault-diff-new{background:var(--vault-accent-soft);border-left:3px solid var(--vault-accent)}@keyframes vault-fade-in{from{opacity:0;transform:translateY(.25rem)}to{opacity:1;transform:translateY(0)}}@media only screen and (max-width:768px){.vault-gate{min-height:50vh;padding:2rem 1rem}.vault-gate-icon{width:48px;height:48px;font-size:1.25rem}.vault-gate-title{font-size:1.375rem}.vault-toolbar{padding:0 1rem}}