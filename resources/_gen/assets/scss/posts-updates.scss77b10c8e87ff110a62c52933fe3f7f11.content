@charset "UTF-8";.posts-update-dot{display:inline-block;width:.5rem;height:.5rem;margin-left:.5rem;vertical-align:super;background:#ffc107;border-radius:50%;cursor:default}.posts-update-dot[hidden]{display:none}.posts-update-dot:not([hidden]){animation:posts-dot-breathe 2.4s ease-in-out infinite}@keyframes posts-dot-breathe{0%,100%{opacity:.45;transform:scale(.8);box-shadow:0 0 rgba(255,193,7,.55)}50%{opacity:1;transform:scale(1);box-shadow:0 0 0 .45rem transparent}}@media(prefers-reduced-motion:reduce){.posts-update-dot:not([hidden]){animation:none}}