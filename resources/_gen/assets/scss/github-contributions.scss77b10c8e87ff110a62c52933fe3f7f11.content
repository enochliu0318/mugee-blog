:root,body.colorscheme-light{--contrib-level-0:rgba(137, 200, 254, 0.1);--contrib-level-1:rgba(137, 200, 254, 0.38);--contrib-level-2:rgba(77, 168, 252, 0.62);--contrib-level-3:#4da8fc;--contrib-level-4:#1679d3}body.colorscheme-dark{--contrib-level-0:rgba(137, 200, 254, 0.1);--contrib-level-1:rgba(137, 200, 254, 0.34);--contrib-level-2:rgba(77, 168, 252, 0.58);--contrib-level-3:#4da8fc;--contrib-level-4:#89c8fe}@media(prefers-color-scheme:dark){body.colorscheme-auto{--contrib-level-0:rgba(137, 200, 254, 0.1);--contrib-level-1:rgba(137, 200, 254, 0.34);--contrib-level-2:rgba(77, 168, 252, 0.58);--contrib-level-3:#4da8fc;--contrib-level-4:#89c8fe}}.github-contributions{min-width:0;padding:1.15rem 0;border-top:1px solid rgba(77,168,252,.34);border-bottom:1px solid rgba(77,168,252,.15);background:radial-gradient(ellipse at 55% 55%,rgba(77,168,252,9%),transparent 72%)}.github-contributions .contributions-heading{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-bottom:1rem;color:var(--alt-fg-color,#666);font-size:1rem}.github-contributions .contributions-heading .contributions-title{display:flex;align-items:center;gap:.55rem;color:var(--fg-color,#212121);font-family:sf mono,Consolas,liberation mono,Menlo,monospace;font-size:1.15rem;font-weight:600;letter-spacing:.08em;white-space:nowrap}.github-contributions .contributions-heading i{color:#4da8fc;font-size:1.3rem;filter:drop-shadow(0 0 6px rgba(77,168,252,.55))}.github-contributions .contributions-heading .contributions-period{padding-left:.55rem;border-left:1px solid var(--darker-alt-bg-color,#ccc);color:var(--alt-fg-color,#666);font-family:inherit;font-size:.95rem;font-weight:400;letter-spacing:0}.github-contributions .contributions-heading a{color:var(--alt-fg-color,#666);font-family:sf mono,Consolas,liberation mono,Menlo,monospace;font-size:1rem;text-decoration:none;white-space:nowrap}.github-contributions .contributions-heading a:hover{color:var(--link-color,#1565c0)}.github-contributions .contributions-chart{overflow-x:auto;padding:.3rem .1rem .4rem}.github-contributions .contribution-weeks{display:grid;grid-template-columns:repeat(22,minmax(0,1fr));gap:clamp(.3rem,.55vw,.55rem);width:100%;max-width:560px;margin:0 auto}.github-contributions .contribution-weeks .contribution-week{display:grid;grid-template-rows:repeat(7,1fr);gap:clamp(.25rem,.4vw,.4rem)}.github-contributions .contribution-weeks .contribution-day{display:block;width:100%;aspect-ratio:1;border:1px solid rgba(77,168,252,8%);border-radius:3px;background:var(--contrib-level-0);box-shadow:inset 0 0 4px rgba(77,168,252,8%);transition:transform .15s ease,box-shadow .15s ease}.github-contributions .contribution-weeks .contribution-day:hover{z-index:1;transform:scale(1.16);box-shadow:0 0 10px rgba(77,168,252,.52)}.github-contributions .contribution-weeks .contribution-day[data-level="1"]{background:var(--contrib-level-1)}.github-contributions .contribution-weeks .contribution-day[data-level="2"]{background:var(--contrib-level-2)}.github-contributions .contribution-weeks .contribution-day[data-level="3"]{background:var(--contrib-level-3)}.github-contributions .contribution-weeks .contribution-day[data-level="4"]{background:var(--contrib-level-4)}.github-contributions .contribution-weeks[hidden],.github-contributions .contributions-fallback[hidden]{display:none}.github-contributions .contributions-fallback{color:var(--alt-fg-color,#666);font-size:1.1rem}@media only screen and (max-width:480px){.github-contributions{padding:.9rem 0}.github-contributions .contributions-heading{gap:.5rem}.github-contributions .contributions-heading .contributions-title{gap:.35rem;font-size:.9rem}.github-contributions .contributions-heading a{font-size:.78rem}.github-contributions .contribution-weeks{gap:.2rem}.github-contributions .contribution-week{gap:.2rem}}